{
  "name": "dsh-daily-push",
  "version": "0.1.1",
  "description": "每日推送：DSH 插件雷达。三榜并列 + 中文搜索 + G/∩/N 三源对照（GitHub / 交集 / npm），每行一键复制安装命令。",
  "license": "MIT",
  "author": "dsh-daily-push contributors",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin-discovery",
    "github",
    "dashboard",
    "chinese"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaa8leitingpifa/dsh-daily-push.git"
  },
  "homepage": "https://github.com/aaa8leitingpifa/dsh-daily-push#readme",
  "bugs": {
    "url": "https://github.com/aaa8leitingpifa/dsh-daily-push/issues"
  },
  "meta": {
    "title": "每日推送",
    "description": "三榜并列的 DSH 插件雷达：星数 / 新建 / 活跃各一列，支持中文关键词搜索、场景分类、GitHub 与 npm 双源对照，内置咨询与关注。"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
