  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin-discovery",
    "github",
    "dashboard",
    "chinese"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaa8leitingpifa/dsh-daily-push.git"
  },
  "homepage": "https://github.com/aaa8leitingpifa/dsh-daily-push#readme",
  "bugs": {
    "url": "https://github.com/aaa8leitingpifa/dsh-daily-push/issues"
  },
  "meta": {
    "title": "每日推送",
    "description": "三榜并列的 DSH 插件雷达：星数、新建、活跃各一榜，官方仓库单独追踪，可咨询、可关注。"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
