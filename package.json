{
  "name": "dsh-daily-push",
  "version": "0.2.0",
  "description": "每日推送：DSH 插件雷达。GitHub 与 npm 全量对照（G / G∩N / N 角标）+ 三榜并列 + 中文搜索，可填 GitHub 令牌提高上限，每行一键复制安装命令。",
  "license": "MIT",
  "author": "dsh-daily-push contributors",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin-discovery",
    "github",
    "dashboard",
    "chinese"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaa8leitingpifa/dsh-daily-push.git"
  },
  "homepage": "https://github.com/aaa8leitingpifa/dsh-daily-push#readme",
  "bugs": {
    "url": "https://github.com/aaa8leitingpifa/dsh-daily-push/issues"
  },
  "meta": {
    "title": "每日推送",
    "description": "全量对照的 DSH 插件雷达：GitHub（最多 1000 条）与 npm（2500 条）按 owner/repo 归一合并，每行标 G / G∩N / N；三榜并列、中文搜索、场景分类、内置咨询与关注，可填 GitHub 令牌。"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
